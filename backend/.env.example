# Copie para .env (e coloque o .env no .gitignore)
# Local: mongodb://localhost:27017  |  Atlas: a URL de conexao do cluster
# Execute a partir da raiz do repositorio para resolver os imports app.*
PYTHONPATH=backend
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sabordacasa
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sabordacasa
