# Copie para .env (e coloque o .env no .gitignore)
# MONGO_URL, POSTGRES_URL e REDIS_URL sao URLs da aplicacao quando ela roda fora
# do Docker. Os Compose substituem essas URLs pelos hosts internos dos servicos.
# MONGO_URL: local (mongodb://localhost:27017) ou URL do Atlas.
PYTHONPATH=backend
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sabordacasa
# Credenciais usadas pelo container PostgreSQL nos Compose.
# A senha tambem compoe a URL interna: prefira letras, numeros, - e _.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_DB=sabordacasa
# URL do PostgreSQL para a aplicacao executada fora do Docker.
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sabordacasa
# URL do Redis para a aplicacao executada fora do Docker.
REDIS_URL=redis://localhost:6379/0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
